@inject IAuthService AuthService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">A alteração se aplica somente à sua conta conectada.</MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_errorMessage</MudAlert>
        }

        <MudTextField T="string" @bind-Value="_currentPassword" Label="Senha atual" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_newPassword" Label="Nova senha (mínimo 8 caracteres)" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_confirmPassword" Label="Confirme a nova senha" InputType="InputType.Password" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ChangePasswordAsync">Alterar senha</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;

    private void Cancel() => MudDialog.Cancel();

    private async Task ChangePasswordAsync()
    {
        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "A confirmação não corresponde à nova senha.";
            return;
        }

        var (success, message) = await AuthService.ChangeCurrentUserPasswordAsync(_currentPassword, _newPassword);
        if (!success)
        {
            _errorMessage = message;
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }
}
